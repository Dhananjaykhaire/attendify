NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/face-recognition-attendance

JWT_SECRET=replace-with-strong-secret
REFRESH_TOKEN_SECRET=replace-with-strong-refresh-secret
JWT_EXPIRY=24h

# Comma-separated list for CORS (app/admin URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CLIENT_URL=http://localhost:5173

# Optional bootstrap admin (used only when no admin exists)
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Admin

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ImageKit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
